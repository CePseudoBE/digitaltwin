# Settings for an application running against docker-compose.dev.yml (see dev/README.md).
# Copy to .env; the compose file also reads DB_PORT and REDIS_PORT from it.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
# Change it when another PostgreSQL already listens on 5432
DB_PORT=5432
DB_USER=digitaltwin
DB_PASSWORD=digitaltwin
DB_NAME=digitaltwin

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=digitaltwin
S3_ACCESS_KEY_ID=digitaltwin
S3_SECRET_ACCESS_KEY=digitaltwin-secret
S3_FORCE_PATH_STYLE=true

REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication: none, oidc or trusted-headers (see packages/auth/README.md)
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8080/default
OIDC_AUDIENCE=digitaltwin
# OIDC_ROLES_CLAIM=roles
# AUTH_ADMIN_ROLE=admin
